{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "1.4.3",
  "description": "DeepSeek Harness Web UI desktop shell (Electron): auto-installs dsh, starts `dsh web` and shows it in a native window",
  "main": "main.js",
  "author": "JIANG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saigetsu233/deepseek-harness-desktop.git"
  },
  "homepage": "https://github.com/Saigetsu233/deepseek-harness-desktop",
  "bugs": {
    "url": "https://github.com/Saigetsu233/deepseek-harness-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "lint": "node --check main.js && node --check plugin-token-cost/lib/index.js && node --check plugin-token-cost/lib/client.js && node --check scripts/security-smoke.js",
    "test": "node scripts/security-smoke.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "icon": "electron scripts/rasterize-icon.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.deepseek.dsh.desktop",
    "productName": "DSH Desktop",
    "files": [
      "main.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "plugin-token-cost",
        "to": "plugin-token-cost"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.exe",
      "uninstallDisplayName": "DSH Desktop",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "portable": {
      "artifactName": "DSH-Desktop-${version}.exe"
    }
  }
}
